# Frontend-only Dockerfile for RAGFlow
# 专门用于构建前端镜像，可以连接到独立的后端容器

# 使用Node.js 20作为基础镜像
FROM node:20-alpine AS base

# 设置工作目录
WORKDIR /ragflow

# 安装必要的系统依赖
RUN apk add --no-cache \
    git \
    python3 \
    make \
    g++ \
    && rm -rf /var/cache/apk/*

# 复制package.json和package-lock.json
COPY web/package*.json ./web/

# 安装前端依赖
WORKDIR /ragflow/web
RUN npm ci --only=production

# 复制前端源代码
COPY web/src ./src
COPY web/public ./public
COPY web/.umirc.ts ./
COPY web/jest.config.ts ./
COPY web/jest-setup.ts ./
COPY web/tsconfig.json ./
COPY web/tsconfig.node.json ./
COPY web/vite.config.ts ./
COPY web/tailwind.config.js ./
COPY web/postcss.config.js ./

# 构建前端
RUN npm run build

# 使用nginx作为生产服务器
FROM nginx:alpine

# 复制构建好的前端文件到nginx目录
COPY --from=base /ragflow/web/dist /usr/share/nginx/html

# 复制nginx配置文件
COPY docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# 创建配置脚本目录
RUN mkdir -p /ragflow/docker

# 复制配置脚本
COPY docker/configure_web.sh /ragflow/docker/
RUN chmod +x /ragflow/docker/configure_web.sh

# 复制配置文件模板
COPY web/src/conf.json.template /ragflow/web/src/
COPY web/src/conf.json /ragflow/web/src/

# 创建启动脚本
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# 配置web前端API服务器地址\n\
if [ -f "/ragflow/docker/configure_web.sh" ]; then\n\
    echo "配置web前端API服务器地址..."\n\
    /ragflow/docker/configure_web.sh\n\
fi\n\
\n\
# 启动nginx\n\
echo "启动nginx服务器..."\n\
exec nginx -g "daemon off;"\n\
' > /ragflow/start-frontend.sh && chmod +x /ragflow/start-frontend.sh

# 暴露端口
EXPOSE 80

# 设置启动命令
CMD ["/ragflow/start-frontend.sh"] 